{
  "name": "soi-db-tools",
  "private": true,
  "description": "Database migration and test runner for SOI. Plain SQL migrations applied with dbmate; works against any Postgres.",
  "type": "module",
  "scripts": {
    "db:status": "dbmate --migrations-dir ../db/migrations --schema-file ../db/schema.sql status",
    "db:up": "dbmate --migrations-dir ../db/migrations --schema-file ../db/schema.sql up",
    "db:down": "dbmate --migrations-dir ../db/migrations --schema-file ../db/schema.sql down",
    "db:new": "dbmate --migrations-dir ../db/migrations --schema-file ../db/schema.sql new",
    "db:dump": "dbmate --migrations-dir ../db/migrations --schema-file ../db/schema.sql dump",
    "db:test": "node db-test.mjs"
  },
  "devDependencies": {
    "dbmate": "2.35.1",
    "pg": "8.23.0"
  }
}
