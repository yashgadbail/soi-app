# Copy to .env and fill in. Passed to the app at build time with
#   flutter run --dart-define-from-file=.env
#   flutter build appbundle --dart-define-from-file=.env
#
# Supabase Dashboard -> Project Settings -> API. Use the PUBLISHABLE key
# (sb_publishable_...). It is safe on the client: every table has row-level
# security and every write goes through a server function. Never put a
# secret/service key here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public web host for verification links printed on certificates.
SOI_WEB_ORIGIN=https://soi.yashgb.com

# Signing credentials do NOT belong here. Gradle does not read this file.
# They live in the user-level ~/.gradle/gradle.properties (see docs/RELEASE.md).
